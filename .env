# Base URL for the remote world maps served by ragassets (consumed by src/sim).
# Every map's manifest + raw geometry + shared (content-addressed) assets live
# under this prefix. Override in .env.local to point the simulator at a local
# map server during development.
VITE_MAPS_URL=https://assets.latam-tools.com.br/maps/

# Our market service (the latam-market project): item pages and the /api/v1
# routes the catalogue's market filters and list view read. Override in
# .env.local (e.g. http://localhost:8788) to develop against a local API — the
# production one only accepts browser calls from this site's own origin.
VITE_MARKET_URL=https://mercado.latam-tools.com.br
